# Local dev: call the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production (Vercel): set NEXT_PUBLIC_API_URL=/api and point BACKEND_URL at the
# deployed backend so next.config.mjs proxies /api/* to it (keeps the auth
# cookie first-party). Leave BACKEND_URL unset locally.
# BACKEND_URL=https://your-backend.up.railway.app
