MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ewmp
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Used to build password-reset links. No email provider is wired up yet —
# reset links are logged to the console (and returned as devResetUrl outside production).
FRONTEND_URL=http://localhost:3000

# In production also set NODE_ENV=production (Secure cookies; no reset URL in the
# API response). PORT is provided by the host. See README "Deployment".
